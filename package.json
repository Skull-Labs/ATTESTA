{
  "name": "attesta",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized academic certificate management on Stellar (Soroban)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@attesta/web",
    "dev:web": "npm run dev --workspace=@attesta/web",
    "dev:api": "npm run dev --workspace=@attesta/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@attesta/web",
    "build:api": "npm run build --workspace=@attesta/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "contracts:build": "stellar contract build --manifest-path contracts/Cargo.toml",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Skull-Labs/ATTESTA.git"
  }
}
